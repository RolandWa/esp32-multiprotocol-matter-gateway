# Gateway-specific settings on top of Espressif's unmodified sdkconfig.defaults (ot_rcp, IDF v6.0.2).
# Applied automatically by IDF for the esp32c6 target.

# Vendor hook of the OpenThread NCP: required by esp-zigbee-sdk / esp-matter zigbee_bridge so that the
# host can talk Zigbee over this RCP (esp-zigbee-sdk zigbee_gateway README, "ot_rcp ... OPENTHREAD_NCP_VENDOR_HOOK").
CONFIG_OPENTHREAD_NCP_VENDOR_HOOK=y

# Link to the S3 host: pins as in the KiCad schematic (hardware/kicad/gw.kicad_sch), numbers in firmware/common/gw_pins.h.
# These are also the chip's UART0 default pins (soc/esp32c6 uart_pins.h: U0TXD 16, U0RXD 17), so setting them explicitly
# changes no behaviour; it makes the decision visible. tests/unit/test_pin_map.py checks them against the schematic.
# UART port (0), 460800 baud and "no flow control" stay as in the vendor esp_ot_config.h; esp_openthread_uart_config_t has
# no RTS/CTS pins, so the schematic's RTS/CTS wires are not used by this stack.
CONFIG_OPENTHREAD_UART_PIN_MANUAL=y
CONFIG_OPENTHREAD_UART_RX_PIN=17
CONFIG_OPENTHREAD_UART_TX_PIN=16
